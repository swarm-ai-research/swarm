# Migrated to swarm-ai-research/swarm-artifacts
runs/
lean/
promo/
/research/
docs/papers/

# Company-role agents (run as independent sessions, not committed).
# Anchored to the repo root: a bare "agents/" would also ignore NEW files
# under swarm/agents/ at any depth.
/agents/

# Relocated directories (prevent re-creation at root)
submissions/
/bridges/
swarm-api/

# API keys and secrets
*.pem
*.key
*_secret*
*_token*
.secrets
secrets.yaml
secrets.json
# Re-include source that legitimately contains "token"/"secret" in its name —
# the patterns above are a secret-file guard, not a ban on the word in code.
!swarm/**/*_token*.py
!swarm/**/*_secret*.py
!tests/**/*_token*.py
!tests/**/*_secret*.py

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.log
*.fls
*.fdb_latexmk
*.synctex.gz

# Binary/regeneratable artifacts (prevent index race conditions across sessions)
*.pdf
*.png
# Exception: viz assets (committed, served by Next.js)
!viz/public/sprites/*.png
!viz/public/splash.png
*.parquet
**/fontlist*.json

# Lean 4 build artifacts (lean/ itself is in swarm-artifacts)
# Kept for completeness if lean/ is ever re-added locally
lean/.lake/
lean/lake-packages/
lean/lake-manifest.json
lean/build/

# GGUF model files (llama.cpp)
models/

# Runtime artifacts
.DS_Store
sandboxes/
.worktrees/
agent-orchestrator.yaml
*.db
# runs/ is fully ignored above (migrated to swarm-artifacts)
node_modules/

# Next.js static export build artifact
docs/game-app/

# Allow documentation images
!docs/**/*.png

# Allow secrets scanner tooling (matched by *_secret* above)
!.claude/hooks/scan_secrets.sh
!.claude/hooks/post_write_check.sh
!.claude/commands/scan_secrets.md

# Session-local docs reminder queue (cleared each commit)
.claude/docs_reminders.log

# Hook bypass audit trail (local-only, see THREAT_MODEL.md §3)
.claude/hook_bypass.log

# Allow provenance audit log (matched by *.jsonl above)
!.claude/provenance.jsonl

# CORAL runtime state (created by `coral start`)
.coral/

# Letta Code
.letta/settings.local.json
!.letta/memory/runs/

# Generated by the kb_graph mkdocs hook on every build (scripts/build_kb_graph.py)
docs/assets/kb_graph.json

# Concurrent-session heartbeats (worktree-discipline guard, bead oldj)
.claude/session-heartbeats/

# Session tool caches (local-only, never commit)
.cache/
.claude/worktrees/
.understand-anything/
